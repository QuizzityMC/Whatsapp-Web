# Environment Configuration Example

# Server Port (default: 3000)
PORT=3000

# Node Environment (development, production)
NODE_ENV=production

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100

# Puppeteer Configuration
# Set to 'true' to skip Chromium download during npm install
PUPPETEER_SKIP_DOWNLOAD=false

# Example of custom Chromium executable path (if needed)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Session Directory (default: .wwebjs_auth)
# SESSION_DIR=.wwebjs_auth

# Cache Directory (default: .wwebjs_cache)
# CACHE_DIR=.wwebjs_cache
